"""Environment configuration file template"""
# Copy this file to .env and fill in your actual values

# Application Environment
RAYMOND_ENV=development
DEBUG=true

# Live Trading (MUST be false by default)
LIVE_TRADING_ENABLED=false

# Database Configuration
DATABASE_URL=sqlite:///./raymond_trading.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://user:password@localhost:5432/raymond_trading

SQL_ECHO=false

# Market Data Provider
# Options: mock, alpha_vantage, twelve_data, alpaca
MARKET_DATA_PROVIDER=mock

# Alpha Vantage API (if using Alpha Vantage)
ALPHA_VANTAGE_API_KEY=your_api_key_here

# MT5 Broker Configuration
MT5_LOGIN=demo_login
MT5_PASSWORD=demo_password
MT5_SERVER=MT5-Demo
MT5_ACCOUNT_TYPE=demo

# Exness Broker Configuration
EXNESS_TOKEN=demo_token
EXNESS_ACCOUNT_ID=demo_account
EXNESS_ACCOUNT_TYPE=demo

# Emergency Stop Configuration
EMERGENCY_API_KEY=your_emergency_stop_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/raymond.log

# CORS
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Strategy Parameters
MIN_CONFIDENCE_THRESHOLD=0.55
MAX_DAILY_LOSS_PERCENT=2.0
MAX_SINGLE_TRADE_LOSS=1.0
MAX_OPEN_POSITIONS=3
MAX_LEVERAGE=20

# Risk Management
EMERGENCY_STOP_THRESHOLD=5.0
MIN_STOP_LOSS_DISTANCE=5.0
