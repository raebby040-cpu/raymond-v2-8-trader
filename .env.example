# Example environment variables for Raymond V2.8 Trader

# Set to true to allow live trading — DO NOT enable in production without review
LIVE_TRADING=false

# Emergency API key used to authorize calls to /emergency-stop
# Set this to a strong secret when you want to enable the emergency endpoint
EMERGENCY_API_KEY=

# FastAPI server port (used when running without Docker)
FASTAPI_PORT=8000

# Optional: host for uvicorn when running directly
FASTAPI_HOST=0.0.0.0

# Example secrets for connectors (placeholders)
MT5_ACCOUNT=
EXNESS_API_KEY=

# Logging / debug
LOG_LEVEL=info

# Database (example) — configure when using a DB
DATABASE_URL=sqlite:///./data/dev.db
