# RAYMOND v2.8 - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# ============================================
# ENVIRONMENT & DEPLOYMENT
# ============================================
RAYMOND_ENV=development  # development|staging|production
LIVE_TRADING_ENABLED=false  # MUST be false by default - only enable in production with approval

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///./data/dev.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/raymond

# ============================================
# BROKER CREDENTIALS (DO NOT COMMIT)
# ============================================
# MetaTrader 5
MT5_LOGIN=demo_login
MT5_PASSWORD=demo_password
MT5_SERVER=MT5-Demo
MT5_ACCOUNT_TYPE=demo

# Exness
EXNESS_TOKEN=demo_token
EXNESS_ACCOUNT_ID=demo_account
EXNESS_ACCOUNT_TYPE=demo

# ============================================
# API KEYS & SECURITY
# ============================================
EMERGENCY_API_KEY=your_strong_emergency_api_key_here
SECRET_KEY=your_jwt_secret_key_here

# ============================================
# MARKET DATA PROVIDER
# ============================================
# Options: alpha_vantage, twelve_data, alpaca, polygon
MARKET_DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
TWELVE_DATA_API_KEY=your_twelve_data_key_here
ALPACA_API_KEY=your_alpaca_key_here
POLYGON_API_KEY=your_polygon_key_here

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO  # DEBUG|INFO|WARNING|ERROR|CRITICAL

# ============================================
# BACKEND SERVER
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true  # false in production

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000
ALLOW_ALL_ORIGINS=true  # false in production

# ============================================
# BACKTESTING
# ============================================
BACKTEST_DATA_PATH=./data/backtests
BACKTEST_RESULTS_PATH=./artifacts/backtests

# ============================================
# NOTIFICATIONS (Optional)
# ============================================
SLACK_WEBHOOK_URL=
EMAIL_SMTP_SERVER=
EMAIL_SENDER=
EMAIL_PASSWORD=