"""
RAYMOND v2.8 - Paper Position Market Loop Tests

Stage 17.3.1

Tests the automatic paper-position market loop.

These tests verify that the loop:
- validates market prices,
- evaluates paper positions,
- persists management decisions through the manager,
- handles temporary market-data failures,
- does not permit live execution,
- does not contact MT5 or a broker,
- does not bypass the Risk Engine,
- does not create duplicate background loops.
"""

from __future__ import annotations

import asyncio

import pytest

from app.paper_position_market_loop import (
    PaperPositionMarketLoop,
    PaperPositionMarketLoopConfig,
)


def run(coro):
    return asyncio.run(coro)


class FakeDatabase:
    pass


def fake_price_provider_factory(price: float):
    async def provider(symbol: str) -> float:
        assert symbol == "XAUUSD"
        return price

    return provider


def failing_price_provider():
    async def provider(symbol: str) -> float:
        raise RuntimeError("temporary market data failure")

    return provider


def test_config_defaults_are_safe():
    config = PaperPositionMarketLoopConfig()

    assert config.symbol == "XAUUSD"
    assert config.interval_seconds == 30.0
    assert config.enabled is True


def test_config_normalizes_symbol():
    config = PaperPositionMarketLoopConfig.from_values(
        symbol=" xauusd ",
        interval_seconds=15,
        enabled=True,
    )

    assert config.symbol == "XAUUSD"
    assert config.interval_seconds == 15.0
    assert config.enabled is True


def test_config_rejects_empty_symbol():
    with pytest.raises(ValueError):
        PaperPositionMarketLoopConfig.from_values(
            symbol="   ",
        )


def test_config_rejects_invalid_interval():
    with pytest.raises(ValueError):
        PaperPositionMarketLoopConfig.from_values(
            interval_seconds=0,
        )


def test_price_provider_is_validated():
    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(4321.25),
    )

    assert run(loop.get_current_price()) == 4321.25


def test_invalid_zero_price_is_rejected():
    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(0),
    )

    with pytest.raises(ValueError):
        run(loop.get_current_price())


def test_invalid_negative_price_is_rejected():
    loop = PaperPositionMarketLoop(
        FakeDatabase(),
