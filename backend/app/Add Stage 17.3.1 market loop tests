def test_invalid_non_numeric_price_is_rejected():
    async def provider(symbol: str):
        return "not-a-price"

    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        provider,
    )

    with pytest.raises(ValueError):
        run(loop.get_current_price())


def test_evaluate_price_returns_safe_result():
    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(4321.25),
    )

    result = loop.evaluate_price(4321.25)

    assert result.symbol == "XAUUSD"
    assert result.current_price == 4321.25
    assert result.success is True

    assert result.paper_only is True
    assert result.read_only is True
    assert result.live_trading_enabled is False
    assert result.execution_authorized is False
    assert result.broker_orders_allowed is False
    assert result.mt5_execution_allowed is False
    assert result.risk_engine_bypass is False


def test_evaluate_price_serializes_results():
    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(4321.25),
    )

    result = loop.evaluate_price(4321.25)
    payload = result.to_dict()

    assert payload["symbol"] == "XAUUSD"
    assert payload["current_price"] == 4321.25
    assert isinstance(payload["results"], list)
    assert payload["safety"]["paper_only"] is True
    assert payload["safety"]["read_only"] is True
    assert payload["safety"]["live_trading_enabled"] is False
    assert payload["safety"]["broker_orders_allowed"] is False
    assert payload["safety"]["mt5_execution_allowed"] is False
    assert payload["safety"]["risk_engine_bypass"] is False


def test_status_is_read_only():
    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(4321.25),
    )

    status = loop.status()

    assert status["component"] == "paper_position_market_loop"
    assert status["symbol"] == "XAUUSD"
    assert status["running"] is False
    assert status["enabled"] is True

    assert status["safety"]["paper_only"] is True
    assert status["safety"]["read_only"] is True
    assert status["safety"]["live_trading_enabled"] is False
    assert status["safety"]["execution_authorized"] is False
    assert status["safety"]["broker_orders_allowed"] is False
    assert status["safety"]["mt5_execution_allowed"] is False
    assert status["safety"]["risk_engine_bypass"] is False


def test_run_once_uses_market_price():
    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(4309.90),
    )

    result = run(loop.run_once())

    assert result.current_price == 4309.90
    assert result.symbol == "XAUUSD"
    assert loop.last_result is result
    assert loop.last_error is None


def test_market_data_failure_is_recorded():
    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        failing_price_provider(),
    )

    with pytest.raises(RuntimeError, match="temporary market data failure"):
        run(loop.run_once())

    assert loop.last_error == "temporary market data failure"


def test_disabled_loop_does_not_run():
    config = PaperPositionMarketLoopConfig(
        enabled=False,
    )

    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(4309.90),
        config=config,
    )

    with pytest.raises(RuntimeError, match="disabled"):
        run(loop.run_once())


def test_disabled_loop_does_not_start():
    config = PaperPositionMarketLoopConfig(
        enabled=False,
    )

    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(4309.90),
        config=config,
    )

    assert loop.start() is False
    assert loop.running is False


def test_start_does_not_create_duplicate_loop():
    async def scenario():
        loop = PaperPositionMarketLoop(
            FakeDatabase(),
            fake_price_provider_factory(4309.90),
            config=PaperPositionMarketLoopConfig(
                interval_seconds=3600,
            ),
        )

        first = loop.start()
        second = loop.start()

        assert first is True
        assert second is False
        assert loop.running is True

        await loop.stop()

        assert loop.running is False

    run(scenario())


def test_stop_is_safe_when_not_running():
    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(4309.90),
    )

    assert run(loop.stop()) is False


def test_close_is_alias_for_stop():
    async def scenario():
        loop = PaperPositionMarketLoop(
            FakeDatabase(),
            fake_price_provider_factory(4309.90),
            config=PaperPositionMarketLoopConfig(
                interval_seconds=3600,
            ),
        )

        assert loop.start() is True
        assert loop.running is True

        await loop.close()

        assert loop.running is False

    run(scenario())


def test_loop_does_not_use_broker_or_mt5():
    """
    Static safety assertion.

    The market loop only owns a price provider and
    PaperPositionManager. No broker or MT5 execution
    interface is accepted by the constructor.
    """

    loop = PaperPositionMarketLoop(
        FakeDatabase(),
        fake_price_provider_factory(4309.90),
    )

    assert not hasattr(loop, "broker")
    assert not hasattr(loop, "mt5")


