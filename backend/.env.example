# Environment Configuration for RAYMOND v2.8 Trading System

# ==================== DATABASE ====================
# SQLite (development): sqlite:///./raymond.db
# PostgreSQL (production): postgresql://user:password@localhost/raymond_db
DATABASE_URL=sqlite:///./raymond.db

# ==================== TRADING MODE ====================
# CRITICAL: Set to false by default. Only enable after thorough review.
LIVE_TRADING_ENABLED=false

# Environment (development, staging, production)
RAYMOND_ENV=development

# ==================== BROKER CREDENTIALS ====================
# MT5 Configuration
MT5_LOGIN=demo_login
MT5_PASSWORD=demo_password
MT5_SERVER=MT5-Demo
MT5_ACCOUNT_TYPE=demo

# Exness Configuration
EXNESS_TOKEN=your_exness_api_token_here
EXNESS_SERVER=https://api.exness.com

# ==================== SECURITY ====================
# Emergency Stop API Key (required for /emergency-stop endpoint)
EMERGENCY_API_KEY=your_emergency_api_key_here

# ==================== LOGGING ====================
LOG_LEVEL=INFO

# ==================== SERVER ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD=true
