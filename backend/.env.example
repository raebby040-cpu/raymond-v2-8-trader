# RAYMOND v2.8 - Environment Configuration

# ==================== DATABASE ====================
DATABASE_URL=sqlite:///./raymond.db

# ==================== TRADING SAFETY ====================
# NEVER change this to true during Step 11.
LIVE_TRADING_ENABLED=false
RAYMOND_ENV=development

# ==================== MT5 ====================
MT5_LOGIN=demo_login
MT5_PASSWORD=demo_password
MT5_SERVER=MT5-Demo
MT5_ACCOUNT_TYPE=demo

# ==================== EXNESS API ====================
# Disabled until the official API details are verified.
EXNESS_API_ENABLED=false
EXNESS_DEMO_ONLY=true

# NEVER commit a real token.
EXNESS_API_TOKEN=

EXNESS_ACCOUNT_ID=
EXNESS_ACCOUNT_TYPE=demo

# Leave blank until the official Exness API documentation
# confirms the correct endpoints.
EXNESS_API_BASE_URL=
EXNESS_API_HEALTH_PATH=
EXNESS_API_ACCOUNT_PATH=
EXNESS_API_POSITIONS_PATH=
EXNESS_API_QUOTE_PATH=
EXNESS_API_ORDER_PATH=
EXNESS_API_CLOSE_PATH=
EXNESS_API_MODIFY_PATH=

EXNESS_API_TIMEOUT_SECONDS=10

# ==================== SECURITY ====================
EMERGENCY_API_KEY=

# ==================== SERVER ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD=true

# ==================== LOGGING ====================
LOG_LEVEL=INFO
